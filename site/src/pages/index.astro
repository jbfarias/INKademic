---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDocs } from '../lib/docs';

const docs = await getDocs();
const featuredDocs = docs.filter((doc) =>
  ['user-guide', 'installation', 'reader-features', 'webserver'].includes(doc.slug)
);
---

<SiteLayout
  title="INKademic"
  description="Academic-focused e-reader firmware for Xteink X3, X4, X4 Pro, and Sticky devices."
  pageClass="home"
>
  <section slot="hero" class="hero">
    <div class="hero-copy">
      <p class="eyebrow">A research-focused fork of <a href="https://crosspointreader.com/">CrossPoint</a></p>
      <h1>INK<span class="inkademic-serif">ademic</span></h1>
      <p class="hero-text">
        Academic notes, highlights, annotation tags, and open-book discovery for Xteink readers.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="https://github.com/jbfarias/INKademic/releases/tag/v1.7.0-rc.2">Download v1.7.0-rc.2</a>
        <a class="button" href="/installation.html">Installation Instructions</a>
      </div>
    </div>
    <img
      src="/images/bitter-small-15-margin.jpg"
      alt="INKademic on an X4 using 10pt Bitter font"
      class="hero-image"
      loading="eager"
    />
  </section>

  <section class="release-section" aria-labelledby="release-title">
    <div class="section-heading">
      <p class="eyebrow">Official release</p>
        <h2 id="release-title">INKademic v1.7.0-rc.2</h2>
    </div>
    <p>
      The current release keeps the fork's ClippingStore v4 format and document identity while providing academic notes, highlights, clippings, bookmarks, user-defined tags, X4 Pro compatibility, and Project Gutenberg as a bundled OPDS catalog across every device build.
    </p>
    <div class="hero-actions">
        <a class="button primary" href="https://github.com/jbfarias/INKademic/releases/download/v1.7.0-rc.2/firmware-x3-x4-v1.7.0-rc.2.bin">Firmware X3/X4</a>
        <a class="button" href="https://github.com/jbfarias/INKademic/releases/download/v1.7.0-rc.2/firmware-x4-pro-v1.7.0-rc.2.bin">Firmware X4 Pro</a>
        <a class="button" href="https://github.com/jbfarias/INKademic/releases/download/v1.7.0-rc.2/firmware-sticky-v1.7.0-rc.2.bin">Firmware Sticky</a>
        <a class="button" href="https://github.com/jbfarias/INKademic/releases/tag/v1.7.0-rc.2">Release notes</a>
    </div>
    <div class="intro-grid">
      <div>
        <span>Annotations</span>
        <strong>Notes, highlights, academic tags, and the web `/highlights` page.</strong>
      </div>
      <div>
        <span>Open books</span>
        <strong>Project Gutenberg is included as an official OPDS catalog.</strong>
      </div>
      <div>
        <span>Diagnostics</span>
        <strong>X3/X4, X4 Pro, and Sticky builds share the academic notes, highlights, clippings, bookmarks, and tag stores.</strong>
      </div>
    </div>
  </section>

  <section class="section-heading">
    <p class="eyebrow">Start here</p>
    <h2>Useful docs</h2>
  </section>
  <nav class="useful-docs" aria-label="Useful documentation">
    {
      featuredDocs.map((doc) => (
        <a href={doc.url}>
          <span>{doc.title}</span>
        </a>
      ))
    }
  </nav>
</SiteLayout>
